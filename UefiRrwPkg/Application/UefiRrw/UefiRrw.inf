[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = uefirrw
  FILE_GUID                      = 3D7A1F52-6C8B-4E29-A0D4-9B1E5F7C2A63
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.5
  ENTRY_POINT                    = UefiMain

[Sources]
